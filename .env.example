# Pooled WebSocket endpoint (PgBouncer transaction mode) — app queries
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"

# Unpooled / direct endpoint — migrations and RLS tests (privileged)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Legacy alias still accepted by migrate/tests:
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon Auth
NEON_AUTH_BASE_URL="https://YOUR_ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://YOUR_ENDPOINT.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_AUTH_COOKIE_SECRET="generate-a-long-random-secret-at-least-32-chars"

# Single config for the public site host (not used as a cookie Domain)
APP_BASE_DOMAIN="akura.elgiriya.com"
