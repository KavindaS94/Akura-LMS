# Supabase Postgres (direct or pooler). Prefer session/transaction pooler that supports SET LOCAL in a transaction.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# Legacy alias:
# DIRECT_URL="..."

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Optional — used for email redirect after signup
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Single config for the public site host (not used as a cookie Domain)
APP_BASE_DOMAIN="akura.elgiriya.com"

# Supabase Storage (server uploads / signed downloads after app authz)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="akura-uploads"
